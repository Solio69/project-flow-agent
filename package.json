{
  "name": "project-flow-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "dev:obsidian": "node --env-file=.env.local esbuild.config.mjs --watch-obsidian",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.0",
    "obsidian": "^1.8.0",
    "typescript": "^5.9.3"
  }
}
